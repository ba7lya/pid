{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/thirdparty/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "warnings": {
        "dev": false,
        "systemVars": true,
        "uninitialized": true,
        "unusedCli": true,
        "deprecated": true
      },
      "errors": {
        "dev": false,
        "deprecated": true
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "MSVC-2022-x64-Ninja",
      "displayName": "MSVC-2022-x64-Ninja",
      "inherits": "msvc-base",
      "toolset": {
        "value": "v143,host=x64",
        "strategy": "external"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "MSVC-2022-x86-Ninja",
      "displayName": "MSVC-2022-x86-Ninja",
      "inherits": "msvc-base",
      "toolset": {
        "value": "v143,host=x86",
        "strategy": "external"
      },
      "architecture": {
        "value": "win32",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x86-windows",
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    },
    {
      "name": "MSVC-2019-x64-Ninja",
      "displayName": "MSVC-2019-x64-Ninja",
      "inherits": "msvc-base",
      "toolset": {
        "value": "v142,host=x64",
        "strategy": "external"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "MSVC-2019-x86-Ninja",
      "displayName": "MSVC-2019-x86-Ninja",
      "inherits": "msvc-base",
      "toolset": {
        "value": "v142,host=x86",
        "strategy": "external"
      },
      "architecture": {
        "value": "win32",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x86-windows",
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    },
    {
      "name": "GCC-Linux-Ninja",
      "displayName": "GCC-Linux-Ninja",
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "Clang-MacOS-Ninja",
      "displayName": "Clang-MacOS-Ninja",
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_HOST_TRIPLET": "arm64-osx",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "MSVC-2022-x64-Ninja-Debug",
      "configurePreset": "MSVC-2022-x64-Ninja",
      "configuration": "Debug",
      "jobs": 12
    },
    {
      "name": "MSVC-2022-x64-Ninja-Release",
      "configurePreset": "MSVC-2022-x64-Ninja",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "MSVC-2022-x86-Ninja-Debug",
      "configurePreset": "MSVC-2022-x86-Ninja",
      "configuration": "Debug",
      "jobs": 12
    },
    {
      "name": "MSVC-2022-x86-Ninja-Release",
      "configurePreset": "MSVC-2022-x86-Ninja",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "MSVC-2019-x64-Ninja-Debug",
      "configurePreset": "MSVC-2019-x64-Ninja",
      "configuration": "Debug",
      "jobs": 12
    },
    {
      "name": "MSVC-2019-x64-Ninja-Release",
      "configurePreset": "MSVC-2019-x64-Ninja",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "MSVC-2019-x86-Ninja-Debug",
      "configurePreset": "MSVC-2019-x86-Ninja",
      "configuration": "Debug",
      "jobs": 12
    },
    {
      "name": "MSVC-2019-x86-Ninja-Release",
      "configurePreset": "MSVC-2019-x86-Ninja",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "GCC-Linux-Ninja-Debug",
      "configurePreset": "GCC-Linux-Ninja",
      "configuration": "Debug",
      "jobs": 12
    },
    {
      "name": "GCC-Linux-Ninja-Release",
      "configurePreset": "GCC-Linux-Ninja",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "Clang-MacOS-Ninja-Debug",
      "configurePreset": "Clang-MacOS-Ninja",
      "configuration": "Debug",
      "jobs": 12
    },
    {
      "name": "Clang-MacOS-Ninja-Release",
      "configurePreset": "Clang-MacOS-Ninja",
      "configuration": "Release",
      "jobs": 12
    }
  ],
  "testPresets": [
    {
      "name": "MSVC-2022-x64-Ninja-Test",
      "configurePreset": "MSVC-2022-x64-Ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "MSVC-2022-x86-Ninja-Test",
      "configurePreset": "MSVC-2022-x86-Ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "MSVC-2019-x64-Ninja-Test",
      "configurePreset": "MSVC-2019-x64-Ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "MSVC-2019-x86-Ninja-Test",
      "configurePreset": "MSVC-2019-x86-Ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "GCC-Linux-Ninja-Test",
      "configurePreset": "GCC-Linux-Ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Clang-MacOS-Ninja-Test",
      "configurePreset": "Clang-MacOS-Ninja",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
